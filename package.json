{
  "name": "greek-trainer",
  "version": "1.0.0",
  "description": "Greek language learning trainer with database support",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/db/init.js && node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node server/db/init.js",
    "migrate": "node migrate.js",
    "migrate:local": "DATABASE_URL=postgresql://localhost:5432/greek_db node migrate.js"
  },
  "keywords": [
    "greek",
    "language",
    "learning",
    "trainer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "sqlite3": "^5.1.6"
  }
}
